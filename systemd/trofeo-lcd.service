[Unit]
Description=Trofeo LCD dashboard
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# Install with cargo install --locked --path .
ExecStart=%h/.cargo/bin/trofeo_lcd
Restart=on-failure
RestartSec=3

# Kalau service gagal connect X11 ("mode game" tidak kedeteksi) padahal
# kamu jalan di X11/XWayland, biasanya DISPLAY/XAUTHORITY belum ke-import ke
# environment systemd --user. Uncomment 2 baris ini (isi sesuai `echo $DISPLAY`
# kamu, biasanya ":0"):
# Environment=DISPLAY=:0
# Environment=XAUTHORITY=%h/.Xauthority

[Install]
WantedBy=graphical-session.target
