[Unit]
Description=Trofeo Vision LCD (info sistem + panel AI INFERENCE InferRig)
# Tunggu sesi grafis (X11/Wayland) siap dulu — integrasi media (mode game,
# X11) butuh sesi ini sudah jalan. InferRig (jika jalan sebagai user unit
# sendiri) tidak jadi dependency keras: panel AI otomatis menampilkan
# OFFLINE kalau API-nya belum siap, lalu pulih sendiri.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# GANTI path ini ke lokasi binary hasil `cargo build --release` kamu.
# Contoh kalau proyek ada di ~/Projects/trofeo-lcd:
ExecStart=%h/Projects/trofeo-lcd/target/release/trofeo_lcd --no-audio --idle-fps 3
Restart=on-failure
RestartSec=3

# Kalau service gagal connect X11 ("mode game" tidak kedeteksi) padahal
# kamu jalan di X11/XWayland, biasanya DISPLAY/XAUTHORITY belum ke-import ke
# environment systemd --user. Uncomment 2 baris ini (isi sesuai `echo $DISPLAY`
# kamu, biasanya ":0"):
# Environment=DISPLAY=:0
# Environment=XAUTHORITY=%h/.Xauthority

[Install]
WantedBy=graphical-session.target
